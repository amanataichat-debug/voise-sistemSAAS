[Unit]
Description=Voksy AI SIP gateway bridge (Asterisk AudioSocket <-> backend WebSocket)
After=network-online.target asterisk.service
Wants=network-online.target

[Service]
Type=simple
User=voksy
Group=voksy
EnvironmentFile=/etc/voksy-bridge/bridge.env
ExecStart=/opt/voksy-bridge/venv/bin/python /opt/voksy-bridge/bridge.py
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
# call recordings: read the MixMonitor WAV, write the MP3, delete after upload
ReadWritePaths=/var/spool/voksy-rec
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
